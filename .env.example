# Copia este archivo como .env y ajusta lo que necesites. Todo es opcional.

# --- Publicación ---
# 127.0.0.1 deja la aplicación solo en este equipo. Usa 0.0.0.0 (o la IP de una interfaz)
# para que otros equipos de la red puedan abrirla.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# --- HTTPS ---
# auto: HTTPS si existen certs/fullchain.pem y certs/privkey.pem; si no, HTTP.
# on:   exige certificados y no arranca sin ellos.
# off:  siempre HTTP (por ejemplo, detrás de un proxy inverso que ya hace TLS).
SECUREPASS_TLS=auto

# --- Let's Encrypt (solo con --profile letsencrypt) ---
# Nombre público con el que se abrirá la aplicación.
DOMAIN=
ACME_EMAIL=
# Módulo DNS de acme.sh para tu proveedor: https://github.com/acmesh-official/acme.sh/wiki/dnsapi
# Ejemplos: dns_cf (Cloudflare), dns_aws (Route 53), dns_gcloud, dns_azure, dns_gd, o "manual".
DNS_PROVIDER=
# Credenciales que pida el módulo elegido. Ejemplo para Cloudflare:
# CF_Token=
# CF_Zone_ID=
